# Copy this file to .env and adjust as needed.

# Debugging. LOG_LEVEL only takes effect when ENVIRONMENT=development (the
# default). DB_ECHO logs every SQL statement — noisy, opt in per-session.
LOG_LEVEL=INFO
DB_ECHO=false

# SQLite needs no server and is fine for local development. Postgres is the
# supported deployment target and is what `docker compose up` starts:
#   DATABASE_URL=postgresql+psycopg://lensword:lensword@localhost:5432/lensword
# The `+psycopg` driver suffix is required — without it SQLAlchemy looks for
# psycopg2, which this project does not depend on.
DATABASE_URL=sqlite:///./data/lensword.db

# Connection-pool bounds. Ignored on SQLite. The ceiling that matters against a
# managed Postgres plan's connection cap is (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# multiplied by the number of running backend instances.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Where scheduled jobs live. "database" (the default) persists them so they
# survive a restart and is required for running more than one backend
# instance; "memory" keeps them in-process. Exclusive firing across instances
# is handled separately and is always on.
SCHEDULER_JOB_STORE=database

SECRET_KEY=change-me-to-a-long-random-value-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Optional: auto-create an admin account on first startup
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# Optional: local AI mnemonic suggestions via Ollama. Leave AI_PROVIDER as
# "none" to keep the feature off entirely. See the README for setup.
AI_PROVIDER=none
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
