# Backend
# Both forms: the trailing-slash pattern alone matches a directory but
# not a symlink of the same name, which a worktree-based checkout may use.
apps/backend/.venv
apps/backend/.venv/
apps/backend/__pycache__/
apps/backend/**/__pycache__/
apps/backend/*.egg-info/
apps/backend/.pytest_cache/
apps/backend/data/
apps/backend/.env

# MCP
apps/mcp/**/__pycache__/
apps/mcp/.pytest_cache/
apps/mcp/*.egg-info/

# Frontend
apps/frontend/node_modules
apps/frontend/node_modules/
apps/frontend/dist/
apps/frontend/.env
apps/frontend/tsconfig.tsbuildinfo

# Desktop shell
# Both forms, for the same reason as the backend entries above.
apps/desktop/target
apps/desktop/target/
apps/desktop/src-tauri/gen/

# Deployment
# Compose reads a root .env automatically, and it holds the database password
# and the token-signing secret. The example beside it is the tracked one.
.env

# General
.DS_Store
*.log

# Internal working notes and design scratch — not part of the published
# project. Documentation intended for contributors belongs in README.md,
# CONTRIBUTING.md, or ROADMAP.md instead.
docs/superpowers/
