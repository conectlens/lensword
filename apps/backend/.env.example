# Copy this file to .env and adjust as needed.

# Debugging. LOG_LEVEL only takes effect when ENVIRONMENT=development (the
# default). DB_ECHO logs every SQL statement — noisy, opt in per-session.
LOG_LEVEL=INFO
DB_ECHO=false

# SQLite needs no server and is fine for local development. Postgres is the
# supported deployment target and is what `docker compose up` starts:
#   DATABASE_URL=postgresql+psycopg://lensword:lensword@localhost:5432/lensword
# The `+psycopg` driver is what's actually installed (not psycopg2), but a
# bare postgresql:// or postgres:// URL — what Supabase/Neon/Railway hand
# you by default — is normalized to it automatically (app/config.py's
# `_require_psycopg_driver`), so this isn't something you have to remember.
DATABASE_URL=sqlite:///./data/lensword.db

# Connection-pool bounds. Ignored on SQLite. The ceiling that matters against a
# managed Postgres plan's connection cap is (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# multiplied by the number of running backend instances.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Where scheduled jobs live. "database" (the default) persists them so they
# survive a restart and is required for running more than one backend
# instance; "memory" keeps them in-process. Exclusive firing across instances
# is handled separately and is always on.
SCHEDULER_JOB_STORE=database

SECRET_KEY=change-me-to-a-long-random-value-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Optional: auto-create an admin account on first startup
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# AI provider. Leave AI_PROVIDER as "none" to keep every AI feature off
# entirely — the default, and what an unattended deploy should stay on
# unless someone deliberately opts in. Set it to exactly one of:
#   ollama  — a self-hosted daemon, see docs/install/local-ai-ollama.md.
#             Local-only: does not work on a host without its own Ollama
#             process (e.g. a typical Render web service).
#   gemini  — Google's Gemini Developer API, a single API key.
#   vertex  — Google Vertex AI, authenticated via GCP Application Default
#             Credentials rather than an API key (see VERTEX_PROJECT_ID
#             below).
#   openai  — the OpenAI API, a single API key.
# Any other value is rejected at startup with a message listing the
# supported ones. Whichever cloud provider you pick, its required field
# below (GEMINI_API_KEY / VERTEX_PROJECT_ID / OPENAI_API_KEY) must also be
# set, or startup fails with a clear error naming exactly what's missing —
# see docs/install/local-ai-ollama.md for the full setup + verification
# story for all four.
AI_PROVIDER=none
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Gemini Developer API. GEMINI_API_KEY is a secret — get one at
# https://aistudio.google.com/apikey, and never commit a real value here
# (this repo's convention for every credential — see SECRET_KEY above).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Vertex AI. No API key field: Vertex authenticates through GCP
# Application Default Credentials, which the google-genai SDK resolves on
# its own (a service-account key file referenced by
# GOOGLE_APPLICATION_CREDENTIALS, or workload identity on GCP compute) — set
# that up in the deploy environment itself, not through a Settings field
# here. VERTEX_PROJECT_ID is the GCP project the Vertex AI API is enabled
# on; it is not itself a secret, but treat GOOGLE_APPLICATION_CREDENTIALS'
# target file the same way as any other credential (never commit it).
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash

# OpenAI. OPENAI_API_KEY is a secret — get one at
# https://platform.openai.com/api-keys, and never commit a real value here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Bring-Your-Own-Key AI credentials (BYOK). This deployment has no
# billing/credits system, so a signed-in user can supply their own
# Gemini/OpenAI/Vertex AI key (Settings page) and it is used automatically
# for their own requests instead of the AI_PROVIDER configured above — see
# docs/install/cloud-ai-providers.md. AI_CREDENTIAL_ENCRYPTION_KEY is the
# one master key every stored credential is encrypted with
# (app/infrastructure/credential_vault.py) — a secret, same as SECRET_KEY
# above, and never commit a real value here. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave it unset to keep BYOK unusable — a user's PUT to
# /api/v1/me/ai-credentials/{provider} fails with a clear 503 rather than
# storing a credential unencrypted.
AI_CREDENTIAL_ENCRYPTION_KEY=
# Separate budget from RATE_LIMIT_AI_REQUESTS above: that one governs
# actual AI generation calls, this one governs writes to a user's own
# stored credential (PUT/DELETE /api/v1/me/ai-credentials/{provider}), a
# different abuse surface with no reason to share or starve the other.
RATE_LIMIT_AI_CREDENTIAL_WRITES=10
RATE_LIMIT_AI_CREDENTIAL_WRITE_WINDOW_SECONDS=60

# Rate limits. Four independent budgets — auth is per IP (no account exists
# yet at login); the rest are per account. Enforced in-process only: correct
# for one running instance, not for more than one behind a balancer — see
# docs/hosted-deployment.md.
RATE_LIMIT_AUTH_ATTEMPTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300
RATE_LIMIT_AI_REQUESTS=15
RATE_LIMIT_AI_WINDOW_SECONDS=60
RATE_LIMIT_FETCH_REQUESTS=20
RATE_LIMIT_FETCH_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_REQUESTS=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60

# Remote MCP over Streamable HTTP + OAuth (issue #196). Off by default — see
# docs/mcp-remote-transport.md before turning this on; it requires TLS
# terminated in front of this backend, which the backend does not do itself.
REMOTE_MCP_ENABLED=false
MCP_ISSUER_URL=http://localhost:8000
MCP_ACCESS_TOKEN_TTL_MINUTES=15
MCP_REFRESH_TOKEN_TTL_DAYS=30
MCP_AUTHORIZATION_CODE_TTL_SECONDS=120
RATE_LIMIT_MCP_OAUTH_ATTEMPTS=20
RATE_LIMIT_MCP_OAUTH_WINDOW_SECONDS=60
