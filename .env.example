# Copy to `.env` next to docker-compose.yml and adjust before deploying.
#
# Compose reads this file automatically. It configures the *stack*; the
# application's own settings live in backend/.env.example, and anything set
# there can also be passed through here via the `environment:` block in
# docker-compose.yml.
#
# `.env` is gitignored. Keep it that way — everything below is a credential.

# --- Database -------------------------------------------------------------
#
# Postgres is the deployment target (ROADMAP 4.0). The compose stack starts it
# and does not publish its port to the host, which is the only reason the
# defaults below are tolerable at all. Change them for anything that is not a
# throwaway local environment.
POSTGRES_USER=lensword
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lensword

# --- Application ----------------------------------------------------------
#
# Signs every access token. Changing it invalidates all existing sessions,
# which is the intended response to a suspected leak. Generate a real one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-value-in-production

# Optional: create an admin account on first boot. Leave both blank to
# register normally and promote the account with a one-off SQL update.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# --- Local AI (optional) ---------------------------------------------------
#
# Off by default (AI_PROVIDER=none) — the mnemonic-suggestion feature simply
# doesn't appear until this is turned on. See docs/install/local-ai-ollama.md,
# especially "Running the backend in Docker with Ollama on the host": this
# backend runs *inside* the Compose network, so OLLAMA_BASE_URL's default of
# `localhost` will not reach Ollama running on your host machine — that page
# has the actual value to use instead (typically `http://host.docker.internal:11434`
# on Docker Desktop, or the host's LAN IP on Linux).
AI_PROVIDER=none
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# --- Remote MCP (optional, advanced) ---------------------------------------
#
# Off by default. See docs/reference/mcp-remote-transport.md before turning
# this on — it requires TLS terminated in front of this backend, which this
# Compose stack does not set up on its own.
REMOTE_MCP_ENABLED=false
MCP_ISSUER_URL=http://localhost:8000

# --- Everything else --------------------------------------------------------
#
# Rate limits, connection-pool sizing, scheduler job store, log level, and
# the rest of apps/backend/.env.example's settings all have working defaults
# and aren't wired through docker-compose.yml's environment: block above —
# add a line there the same way as the ones above if you need to override
# one. apps/backend/.env.example documents every setting this application
# reads, whether or not Compose passes it through.
