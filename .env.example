# Copy to `.env` next to docker-compose.yml and adjust before deploying.
#
# Compose reads this file automatically. It configures the *stack*; the
# application's own settings live in backend/.env.example, and anything set
# there can also be passed through here via the `environment:` block in
# docker-compose.yml.
#
# `.env` is gitignored. Keep it that way — everything below is a credential.

# --- Database -------------------------------------------------------------
#
# Postgres is the deployment target (ROADMAP 4.0). The compose stack starts it
# and does not publish its port to the host, which is the only reason the
# defaults below are tolerable at all. Change them for anything that is not a
# throwaway local environment.
POSTGRES_USER=lensword
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lensword

# --- Application ----------------------------------------------------------
#
# Signs every access token. Changing it invalidates all existing sessions,
# which is the intended response to a suspected leak. Generate a real one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-value-in-production

# Optional: create an admin account on first boot. Leave both blank to
# register normally and promote the account with a one-off SQL update.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
